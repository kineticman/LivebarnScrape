# LiveBarn Manager - Systemd Service (Optional - for non-Docker deployment)
# File: /etc/systemd/system/livebarn.service

[Unit]
Description=LiveBarn Favorites Manager
After=network.target

[Service]
Type=simple
User=livebarn
Group=livebarn
WorkingDirectory=/opt/livebarn
EnvironmentFile=-/etc/livebarn/livebarn.env
Environment="SERVER_PORT=5000"
Environment="DB_PATH=/opt/livebarn/data/livebarn.db"
Environment="LOG_LEVEL=INFO"
ExecStart=/opt/livebarn/.venv/bin/python /opt/livebarn/livebarn_manager.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

# Installation Instructions:
# 1. Create user: sudo useradd -r -s /bin/false livebarn
# 2. Create directory: sudo mkdir -p /opt/livebarn/data
# 3. Copy files to /opt/livebarn/
# 4. Create a venv and install requirements.txt
# 5. Install Chromium in that venv: playwright install chromium
# 6. Put optional credentials/admin settings in /etc/livebarn/livebarn.env
# 7. Restrict it: sudo chmod 600 /etc/livebarn/livebarn.env
# 8. Copy this file to /etc/systemd/system/livebarn.service
# 9. Enable: sudo systemctl enable livebarn
# 10. Start: sudo systemctl start livebarn
# 11. View logs: sudo journalctl -u livebarn -f
#
# Note: Docker deployment is recommended over systemd
